# Shared
ENVIRONMENT=development

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# API
PROJECT_NAME=AAZADI
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://aazadi:aazadi@localhost:5432/aazadi
JWT_SECRET_KEY=change-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=30
UPLOAD_STORAGE_BACKEND=local
UPLOAD_LOCAL_ROOT=./uploads
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:3000
